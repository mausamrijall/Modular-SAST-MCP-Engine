# Copy this file to .env and fill in the placeholders with YOUR OWN values.
# Never commit a .env file with a real key to the repository.

# Provider name, used for display only.
USER_LLM_PROVIDER=openai-compatible

# Endpoint root of an OpenAI-compatible chat completions API.
USER_LLM_BASE_URL=https://api.openai.com/v1

# Your API key. Replace with a key you obtain from your provider.
USER_LLM_API_KEY=your-api-key-here

# Model identifier served by the endpoint above.
USER_LLM_MODEL=gpt-4o-mini
